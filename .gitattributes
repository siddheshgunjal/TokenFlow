# Keep text files LF in every checkout. The release tooling (bash scripts,
# Node version sync, Flatpak manifests) runs on Linux, macOS, and Windows.
* text=auto eol=lf

# Binary assets must never be converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
