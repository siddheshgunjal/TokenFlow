{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenFlow",
  "version": "0.1.0",
  "identifier": "io.github.siddheshgunjal.TokenFlow",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TokenFlow",
        "width": 1180,
        "height": 780,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false,
        "create": false
      },
      {
        "label": "widget",
        "title": "TokenFlow Widget",
        "url": "widget.html",
        "width": 390,
        "height": 320,
        "minWidth": 360,
        "minHeight": 300,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "focus": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local token usage analytics for Ollama and DeepSeek",
    "longDescription": "TokenFlow is a local-first desktop companion that proxies Ollama traffic to measure token usage and polls the DeepSeek balance API. All telemetry stays on your machine.",
    "copyright": "Copyright © 2026 Siddhesh Gunjal",
    "licenseFile": "../LICENSE",
    "homepage": "https://token-flow.xyz/",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libxdo3",
          "libdbus-1-3"
        ],
        "files": {
          "/usr/share/metainfo/io.github.siddheshgunjal.TokenFlow.metainfo.xml": "../packaging/io.github.siddheshgunjal.TokenFlow.metainfo.xml"
        }
      },
      "rpm": {
        "depends": ["libdbus-1.so.3()(64bit)"],
        "files": {
          "/usr/share/metainfo/io.github.siddheshgunjal.TokenFlow.metainfo.xml": "../packaging/io.github.siddheshgunjal.TokenFlow.metainfo.xml"
        }
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
