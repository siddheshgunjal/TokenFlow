{
  "name": "tokenflow-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Public website and interactive dashboard demo for TokenFlow",
  "author": "Siddhesh Gunjal",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/fetch-release-version.mjs",
    "build": "npm run demo:check && npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
