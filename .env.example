# Copy to .env (never commit real secrets) or export these in your shell.
#
# DeepSeek key. When set, it takes precedence over the key saved in the app.
DEEPSEEK_API_KEY=

# Optional overrides for first launch. Saved settings take precedence afterward.
TOKENFLOW_UPSTREAM_URL=http://127.0.0.1:11434
TOKENFLOW_PROXY_PORT=11435
TOKENFLOW_DEEPSEEK_BASE_URL=https://api.deepseek.com
TOKENFLOW_DEEPSEEK_POLL_SECS=900

# Logging (Rust)
RUST_LOG=tokenflow=info,tower_http=warn
